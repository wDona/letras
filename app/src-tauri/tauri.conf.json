{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Letras",
  "version": "0.1.0",
  "identifier": "dev.wdona.letras",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Letras",
        "width": 1100,
        "height": 820,
        "minWidth": 480,
        "minHeight": 360,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
